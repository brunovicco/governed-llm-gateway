# Governed LLM Gateway local-development environment example.
#
# IMPORTANT:
# - The Python runtime does NOT automatically load this file.
# - Copy it to `.env`, set local values, then export/source it before starting.
# - `.env` is gitignored. Never commit real credentials.

# Required only for the bounded operations-only local demo (PC-29/PC-30).
# Use a random local value. The demo fails closed when this is missing/empty.
GATEWAY_LOCAL_DEMO_API_KEY=

# Optional governed live-inference development profile (PC-33).
# The consumer presents only GATEWAY_DEMO_API_KEY. The Policy Router credential
# remains inside the Gateway/PDP deployment boundary.
# GATEWAY_DEMO_API_KEY=
# POLICY_ROUTER_DEMO_API_KEY=
# Optional override. The governed Compose profile otherwise pulls the reviewed
# multi-architecture Router release by immutable digest from compose.gateway.yml.
# POLICY_MODEL_ROUTER_IMAGE=

# Optional for the fail-closed baseline; the governed Compose profile's enabled
# personal-default deployments require all six values below at startup. Disable both
# the unavailable deployment and its provider binding when running with fewer providers.
# These are read only when a reviewed provider-runtime artifact contains a binding
# whose `credential_reference` points to the matching environment name and a
# corresponding deployment exists in the selected Model Registry artifact.
#
# The checked-in default registry/provider/policy baseline remains intentionally
# empty/disabled, so setting these variables alone does NOT enable live inference.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
